# California Political Knowledge Map - Prompt Testing Playground Environment

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=extraction_model
OLLAMA_EMBEDDING_MODEL=embedder

# Neo4j Graph Database Settings (Optional - Playground will save to graph if configured)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Open States API Key
OPEN_STATES_API_KEY=key

# Chunking deets
CHUNK_SIZE=1000
CHUNK_OVERLAP_PCT=.1