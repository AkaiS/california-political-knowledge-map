# California Political Knowledge Map - Prompt Testing Playground Environment

# llama.cpp Settings (chat / tool calling)
# llama-server compiles the structured-output schema to a GBNF grammar and
# enforces it. Start it with `scripts/llama-server.sh`.
LLAMA_CPP_BASE_URL=http://localhost:8080
LLAMA_CPP_MODEL=gemma4:26b
LLM_TEMPERATURE=0
LLM_TOP_P=
LLM_TOP_K=
# Gemma 4's template defaults thinking off; llama.cpp's `--reasoning auto`
# turns it on, and nothing bounds it.  Set to `on` to reason before answering.
LLM_THINKING=off
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=
LLM_TRANSPORT_REQUEST_TIMEOUT=3600
LLM_TRANSPORT_MAX_ATTEMPTS=3
LLM_TRANSPORT_RATE_LIMIT_WAIT_CAP=120

# Commands that run agents refuse to start when a local llama.cpp endpoint does
# not answer. Set to a non-empty value to run them anyway, as `--skip-model-check`
# does for one command.
SKIP_MODEL_REACHABILITY_CHECK=

# OpenRouter Settings (chat)
# Replace the placeholder with an OpenRouter key at launch. The application
# never stores the key in a Model Deployment or report. Google AI Studio BYOK
# is configured in OpenRouter's workspace, not with a direct Google key here.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_PROVIDERS=google-ai-studio, openai

# Query Rewriter Settings (independent of construction and ingestion)
# Select local|openrouter and explicitly name the chosen rewriter model.
# A local rewriter can use a separate, more capable llama-server on another port.
QUERY_REWRITER_DEPLOYMENT=local
QUERY_REWRITER_MODEL=gemma4:26b
# Blank uses LLAMA_CPP_BASE_URL; ignored for OpenRouter.
QUERY_REWRITER_BASE_URL=

# Local browser chat fixes the Chat Agent and Jev composer/binder deployment
# at startup. Select local|openrouter using the model settings above.
CHAT_DEPLOYMENT=local
# Jev schema/role selection. Blank uses Keychain service jev_api, account test_key.
TYPESAFE_API_KEY=
# Existing corpus metadata and writable saved Source Guides.
SQLITE_DB_PATH=document_store.db

# Cloud visitor controls are opt-in; the local service keeps its existing behavior.
# The cloud entry point requires the exact HTTPS app origin and a single worker.
CLOUD_PUBLIC_MODE=0
CLOUD_PUBLIC_ORIGIN=
# Trust only the observed Bottle router peer networks, never all client addresses.
CLOUD_TRUSTED_PROXIES=
# Space-separated HTTPS origins allowed to embed the page in an iframe.
CLOUD_FRAME_ANCESTORS=
CLOUD_ACTIVE_QUESTIONS=1
CLOUD_QUEUED_QUESTIONS=2
CLOUD_HOURLY_SUBMISSIONS=3
CLOUD_DAILY_SUBMISSIONS=20
CLOUD_MAX_QUESTION_CHARACTERS=4000
CLOUD_MAX_BODY_BYTES=32768
CLOUD_QUESTION_DEADLINE_SECONDS=240
CLOUD_GUIDE_RETENTION_DAYS=30

# llama.cpp Settings (embeddings)
# A second llama-server process, because it serves one model per process.  Start
# it with `scripts/llama-embed.sh`.  The weights are the same EmbeddingGemma
# model family used before, so the vectors remain in the local embedding space.
LLAMA_CPP_EMBEDDING_BASE_URL=http://localhost:8081
EMBEDDING_MODEL=embeddinggemma

# Neo4j Graph Database Settings (Optional - Playground will save to graph if configured)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Open States API Key
OPEN_STATES_API_KEY=key

# --- Observability (see docs/agents/secrets.md) ---
# The write token is NOT stored here. Runs refuse to start without one:
# `keyring set logfire dev-telemetry` puts it in the OS keychain, where every
# later run finds it regardless of the directory the command was issued from.
# The project URL is not a secret, and is what turns a trace id into a link.
LOGFIRE_PROJECT_URL=https://logfire-us.pydantic.dev/<account>/<project>
