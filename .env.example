# California Political Knowledge Map - Prompt Testing Playground Environment

# llama.cpp Settings (chat / tool calling)
# llama-server compiles the structured-output schema to a GBNF grammar and
# enforces it. Start it with `scripts/llama-server.sh`.
LLAMA_CPP_BASE_URL=http://localhost:8080
LLAMA_CPP_MODEL=gemma4:26b
LLM_TEMPERATURE=0
# Gemma 4's template defaults thinking off; llama.cpp's `--reasoning auto`
# turns it on, and nothing bounds it.  Set to `on` to reason before answering.
LLM_THINKING=off

# OpenRouter Settings (chat)
# Replace the placeholder with an OpenRouter key at launch. The application
# never stores the key in a Model Deployment or report. Google AI Studio BYOK
# is configured in OpenRouter's workspace, not with a direct Google key here.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_PROVIDERS=google-ai-studio, openai

# llama.cpp Settings (embeddings)
# A second llama-server process, because it serves one model per process.  Start
# it with `scripts/llama-embed.sh`.  The weights are the same EmbeddingGemma
# model family used before, so the vectors remain in the local embedding space.
LLAMA_CPP_EMBEDDING_BASE_URL=http://localhost:8081
EMBEDDING_MODEL=embeddinggemma

# Neo4j Graph Database Settings (Optional - Playground will save to graph if configured)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Open States API Key
OPEN_STATES_API_KEY=key

# Pydantic Logfire Token (Optional, local dev uses CLI OAuth credentials)
LOGFIRE_TOKEN=your_logfire_token_here
