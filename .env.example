# California Political Knowledge Map - Prompt Testing Playground Environment

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=extraction_model
OLLAMA_EMBEDDING_MODEL=embedder
OLLAMA_MODEL_EXTRACTION=gemma4:31b
OLLAMA_MODEL_COREFERENCE=8k-gemma-e4b-extraction
OLLAMA_MODEL_RELEVANCE=32k-gemma-e4b
OLLAMA_MODEL_HEALING=32k-gemma-e4b


# llama.cpp Settings (chat / tool calling)
# Ollama accepts `tool_choice: "required"` and ignores it; llama-server compiles
# the tool schema to a GBNF grammar and enforces it.  Start it with
# `scripts/llama-server.sh`.  Ollama is still used for embeddings above.
LLAMA_CPP_BASE_URL=http://localhost:8080
LLM_TEMPERATURE=0
# Gemma 4's template defaults thinking off; llama.cpp's `--reasoning auto`
# turns it on, and nothing bounds it.  Set to `on` to reason before answering.
LLM_THINKING=off

# Neo4j Graph Database Settings (Optional - Playground will save to graph if configured)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Open States API Key
OPEN_STATES_API_KEY=key

# Pydantic Logfire Token (Optional, local dev uses CLI OAuth credentials)
LOGFIRE_TOKEN=your_logfire_token_here
