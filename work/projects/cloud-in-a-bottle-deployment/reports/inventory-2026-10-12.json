      "publication_discovery_state": {
        "rows": 0,
        "schema": "CREATE TABLE publication_discovery_state (\n                publication_id TEXT PRIMARY KEY,\n                state_json TEXT NOT NULL,\n                updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n                FOREIGN KEY(publication_id) REFERENCES publications(id) ON DELETE CASCADE\n            )"
      },
      "publication_selectors": {
        "rows": 7,
        "schema": "CREATE TABLE publication_selectors (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                publication_id TEXT NOT NULL,\n                selectors_json TEXT NOT NULL,\n                earliest_success_date DATETIME,\n                latest_success_date DATETIME,\n                created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n                FOREIGN KEY(publication_id) REFERENCES publications(id) ON DELETE CASCADE\n            )"
      },
      "publications": {
        "rows": 1,
        "schema": "CREATE TABLE publications (\n                id TEXT PRIMARY KEY,\n                name TEXT NOT NULL,\n                base_url TEXT NOT NULL,\n                crawl_delay REAL DEFAULT 2.0,\n                max_concurrency INTEGER DEFAULT 2,\n                use_robots_txt BOOLEAN DEFAULT 1,\n                discovery_config_json TEXT,\n                archive_cutoff_years INTEGER DEFAULT 5,\n                validation_paused BOOLEAN DEFAULT 0,\n                failure_points INTEGER DEFAULT 0,\n                healing_in_progress BOOLEAN DEFAULT 0,\n                created_at DATETIME DEFAULT CURRENT_TIMESTAMP\n            , tripping_article_url TEXT)"
      },
      "scraped_html_cache": {
        "rows": 215,
        "schema": "CREATE TABLE scraped_html_cache (\n                        url TEXT PRIMARY KEY,\n                        publication_id TEXT NOT NULL,\n                        raw_html TEXT,\n                        validation TEXT CHECK(validation IN ('PENDING', 'VALIDATED', 'VALIDATION_FAILED', 'UNVALIDATABLE')) DEFAULT 'PENDING',\n                        validation_date DATETIME,\n                        scraped_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n                        headline TEXT,\n                        description TEXT,\n                        embedding BLOB,\n                        relevance_status TEXT CHECK(relevance_status IN ('RELEVANT', 'IRRELEVANT', 'INCONCLUSIVE', 'PENDING')) DEFAULT 'PENDING',\n                        relevance_label_source TEXT CHECK(relevance_label_source IN ('KEYWORD', 'LLM', 'HUMAN', 'MODEL')) DEFAULT 'KEYWORD',\n                        fetch_status INTEGER,\n                        raw_metadata_json TEXT,\n                        FOREIGN KEY(publication_id) REFERENCES publications(id) ON DELETE CASCADE\n                    )"
      },
      "selector_proposals": {
        "rows": 34,
        "schema": "CREATE TABLE selector_proposals (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                publication_id TEXT NOT NULL,\n                selectors_json TEXT NOT NULL,       -- Candidate article selectors (title, author, date, body)\n                trigger_article_url TEXT NOT NULL,  -- The VALIDATION_FAILED article that tripped the breaker (Recovery Check target)\n                status TEXT CHECK(status IN ('PENDING_REVIEW', 'APPROVED', 'REJECTED', 'HEALING_FAILED')) DEFAULT 'PENDING_REVIEW',\n                critic_iterations INTEGER,          -- Number of Generator/Critic iterations consumed\n                created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n                resolved_at DATETIME,\n                FOREIGN KEY(publication_id) REFERENCES publications(id) ON DELETE CASCADE\n            )"
      },
      "source_guide_attempts": {
        "rows": 7,
        "schema": "CREATE TABLE source_guide_attempts (\n                    attempt_id TEXT PRIMARY KEY,\n                    guide_id TEXT NOT NULL REFERENCES source_guides(guide_id),\n                    started_at TEXT NOT NULL,\n                    finished_at TEXT,\n                    status TEXT NOT NULL CHECK(status IN (\n                        'running', 'completed', 'empty', 'failed', 'cancelled', 'interrupted'\n                    )),\n                    outcome_json TEXT\n                )"
      },
      "source_guides": {
        "rows": 6,
        "schema": "CREATE TABLE source_guides (\n                    guide_id TEXT PRIMARY KEY,\n                    question TEXT NOT NULL,\n                    created_at TEXT NOT NULL,\n                    latest_attempt_id TEXT NOT NULL,\n                    content_json TEXT,\n                    retrieved_at TEXT\n                )"
      },
      "stories": {
        "rows": 157,
        "schema": "CREATE TABLE \"stories\" (\n                    id INTEGER PRIMARY KEY AUTOINCREMENT,\n                    title TEXT NOT NULL,\n                    url TEXT NOT NULL UNIQUE,\n                    category TEXT,\n                    author TEXT,\n                    published_date TEXT,\n                    summary TEXT,\n                    content TEXT,\n                    status TEXT CHECK(status IN ('UNPROCESSED', 'PROCESSING', 'COMPLETED', 'FAILED_DLQ', 'SYSTEM_ERROR')) DEFAULT 'UNPROCESSED',\n                    completed_at DATETIME,\n                    created_at DATETIME DEFAULT CURRENT_TIMESTAMP\n                )"
      },
      "story_links": {
        "rows": 1721,
        "schema": "CREATE TABLE story_links (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                story_id INTEGER NOT NULL,\n                text TEXT,\n                url TEXT NOT NULL,\n                scraped BOOLEAN DEFAULT 0,\n                created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n                FOREIGN KEY(story_id) REFERENCES stories(id) ON DELETE CASCADE,\n                UNIQUE(story_id, url)\n            )"
      }
