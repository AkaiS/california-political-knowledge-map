  "detail_queries": {
    "graph_publication_dates": "MATCH (a:NewsArticle) RETURN min(toString(a.published_date)) AS earliest, max(toString(a.published_date)) AS latest, sum(CASE WHEN a.published_date IS NULL THEN 1 ELSE 0 END) AS missing",
    "stance_keys": "MATCH ()-[r:DECLARED_STANCE]->() RETURN r.alignment AS alignment, keys(r) AS properties, count(*) AS count ORDER BY count DESC",
    "funding_keys": "MATCH ()-[r:FUNDED]->() RETURN r.amount IS NOT NULL AS has_amount, r.date IS NOT NULL AS has_date, keys(r) AS properties, count(*) AS count ORDER BY count DESC",
    "multiple_base_labels": "MATCH (n) WITH n, [x IN labels(n) WHERE x IN $base_labels] AS base_labels WHERE size(base_labels)<>1 RETURN base_labels, count(*) AS count",
    "E1": "MATCH (n:Politician)-[:MENTIONED_IN]->(c:Chunk) RETURN count(*) AS paths, count(DISTINCT n) AS seeds, count(DISTINCT c) AS chunks",
    "E2": "MATCH (n)-[:MENTIONED_IN]->(c:Chunk) WHERE n:Bill OR n:Prop RETURN count(*) AS paths, count(DISTINCT n) AS seeds, count(DISTINCT c) AS chunks",
    "E3": "MATCH (p:PolicyArea)<-[:DISCUSSES_TOPIC]-(a:NewsArticle)-[:HAS_CHUNK]->(c:Chunk) RETURN count(*) AS paths, count(DISTINCT p) AS seeds, count(DISTINCT a) AS articles, count(DISTINCT c) AS chunks",
    "R1": "MATCH (a)-[r:DECLARED_STANCE|ENDORSED|DENOUNCED]->(b) WHERE (a:Politician OR a:Organization) AND (b:Bill OR b:Prop OR b:Campaign) RETURN count(r) AS relationships, count(DISTINCT a) AS actors, count(DISTINCT b) AS targets",
    "R2": "MATCH (o:Organization)-[r:LOBBIED_FOR|LOBBIED_AGAINST]->(b:Bill) RETURN count(r) AS relationships, count(DISTINCT o) AS actors, count(DISTINCT b) AS measures",
    "R3": "MATCH (o:Organization)-[r:FUNDED]->(c:Campaign) RETURN count(r) AS relationships, count(DISTINCT o) AS actors, count(DISTINCT c) AS campaigns",
    "M1": "MATCH (o:Organization)-[:LOBBIED_FOR|LOBBIED_AGAINST|DECLARED_STANCE]->(b:Bill)-[:ABOUT_TOPIC]->(p:PolicyArea) RETURN count(*) AS paths, count(DISTINCT o) AS actors, count(DISTINCT b) AS measures, count(DISTINCT p) AS areas",
    "M2_topology_only": "MATCH (a:Organization)-[r:DECLARED_STANCE]->(b:Bill)<-[s:DECLARED_STANCE]-(other) WHERE a<>other AND (other:Organization OR other:Politician) RETURN count(*) AS ordered_paths, sum(CASE WHEN r.alignment IS NOT NULL AND r.alignment=s.alignment THEN 1 ELSE 0 END) AS same_alignment_paths",
    "M3": "MATCH (p:Politician)-[:MENTIONED_IN]->(c:Chunk)<-[:MENTIONED_IN]-(o:Organization) RETURN count(*) AS paths, count(DISTINCT c) AS chunks",
    "M4": "MATCH (o:Organization)-[:FUNDED]->(c:Campaign)-[:CAMPAIGN_FOR]->(p:Politician)-[:DECLARED_STANCE]->(b:Bill) RETURN count(*) AS paths",
    "M5": "MATCH (p:Politician)-[:VOTED_AYE|VOTED_NO|ABSTAINED]->(e:LegislativeEvent)-[:ACTION_ON]->(b:Bill) RETURN count(*) AS paths, count(DISTINCT p) AS politicians, count(DISTINCT e) AS events, count(DISTINCT b) AS bills",
    "committee_hearings": "MATCH (b:Bill)<-[:ACTION_ON]-(e:LegislativeEvent)-[:HELD_BY]->(c:Committee) RETURN count(*) AS paths",
    "committee_referrals": "MATCH (:Bill)-[r:REFERRED_TO]->(:Committee) RETURN count(r) AS relationships",
    "final_totals": "MATCH (n) WITH count(n) AS nodes MATCH ()-[r]->() RETURN nodes, count(r) AS relationships"
  },
