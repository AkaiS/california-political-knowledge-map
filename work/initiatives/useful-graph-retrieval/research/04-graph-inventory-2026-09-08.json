{
  "started_at_utc": "2026-09-08T19:15:18.775848+00:00",
  "queries": {
    "nodes": "MATCH (n) RETURN count(n) AS count",
    "relationships": "MATCH ()-[r]->() RETURN count(r) AS count",
    "labels": "MATCH (n) UNWIND labels(n) AS label RETURN label, count(*) AS count ORDER BY label",
    "label_sets": "MATCH (n) RETURN labels(n) AS labels, count(*) AS count ORDER BY count DESC",
    "relationship_types": "MATCH ()-[r]->() RETURN type(r) AS type, count(*) AS count ORDER BY type",
    "relationship_shapes": "MATCH (a)-[r]->(b) RETURN labels(a) AS source_labels, type(r) AS type, labels(b) AS target_labels, count(*) AS count ORDER BY type, count DESC",
    "article_records": "MATCH (a:NewsArticle) RETURN a.id AS id, toString(a.published_date) AS published_date",
    "article_chunk_counts": "MATCH (a:NewsArticle) OPTIONAL MATCH (a)-[:HAS_CHUNK]->(c:Chunk) WITH a, count(c) AS chunks RETURN count(*) AS articles, sum(chunks) AS attached_chunks, min(chunks) AS minimum, max(chunks) AS maximum, sum(CASE WHEN chunks=0 THEN 1 ELSE 0 END) AS without_chunks",
    "chunks": "MATCH (c:Chunk) RETURN count(*) AS count, sum(CASE WHEN c.text IS NULL OR c.text=\"\" THEN 1 ELSE 0 END) AS without_text, sum(CASE WHEN c.embedding IS NULL THEN 1 ELSE 0 END) AS without_embedding, sum(CASE WHEN NOT EXISTS { MATCH (:NewsArticle)-[:HAS_CHUNK]->(c) } THEN 1 ELSE 0 END) AS without_article",
    "embedding_dimensions": "MATCH (c:Chunk) RETURN size(c.embedding) AS dimensions, count(*) AS count ORDER BY count DESC",
    "entities_without_chunks": "MATCH (n) WHERE any(label IN labels(n) WHERE label IN $entity_labels) RETURN count(n) AS entities, sum(CASE WHEN NOT EXISTS { MATCH (n)-[:MENTIONED_IN]->(:Chunk) } THEN 1 ELSE 0 END) AS without_chunks",
    "claim_provenance": "MATCH ()-[r]->() WHERE type(r) IN $claim_types RETURN type(r) AS type, count(*) AS count, sum(CASE WHEN size(coalesce(r.chunks, []))=0 AND size(coalesce(r.articles, []))=0 THEN 1 ELSE 0 END) AS without_provenance, sum(CASE WHEN r.needs_review=true THEN 1 ELSE 0 END) AS needs_review, sum(CASE WHEN size(coalesce(r.chunks, []))>0 THEN 1 ELSE 0 END) AS with_chunks, sum(CASE WHEN size(coalesce(r.articles, []))>0 THEN 1 ELSE 0 END) AS with_articles ORDER BY type",
    "dangling_chunk_provenance": "MATCH ()-[r]->() WHERE type(r) IN $claim_types UNWIND coalesce(r.chunks, []) AS id WITH r, id WHERE NOT EXISTS { MATCH (c:Chunk) WHERE c.id=id } RETURN count(*) AS missing_references, count(DISTINCT r) AS affected_relationships",
    "dangling_article_provenance": "MATCH ()-[r]->() WHERE type(r) IN $claim_types UNWIND coalesce(r.articles, []) AS id WITH r, id WHERE NOT EXISTS { MATCH (a:NewsArticle) WHERE a.id=id } RETURN count(*) AS missing_references, count(DISTINCT r) AS affected_relationships",
    "review_nodes": "MATCH (n) WHERE n.needs_review=true RETURN labels(n) AS labels, count(*) AS count",
    "bill_resolution": "MATCH (n:Bill) RETURN count(*) AS count, sum(CASE WHEN n.session IS NULL THEN 1 ELSE 0 END) AS without_session, sum(CASE WHEN n.needs_review=true THEN 1 ELSE 0 END) AS needs_review",
    "topic_sources": "MATCH (n)-[:DISCUSSES_TOPIC]->(:PolicyArea) RETURN labels(n) AS labels, count(*) AS count",
    "duplicate_ids": "MATCH (n) UNWIND labels(n) AS label WITH label, n.id AS id, count(*) AS count WHERE id IS NOT NULL AND count>1 RETURN label, count(*) AS duplicated_id_groups, sum(count) AS affected_nodes ORDER BY label"
  },
